{
  "name": "hush-sync-ts",
  "version": "0.1.0",
  "description": "Node.js / Electron SDK for hush-sync — E2EE, local-first device sync without accounts or lock-in",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "homepage": "https://github.com/julianbonomini/hush-sync-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julianbonomini/hush-sync-ts.git"
  },
  "keywords": [
    "hush",
    "sync",
    "e2ee",
    "encryption",
    "noise-protocol",
    "local-first",
    "offline-first",
    "napi",
    "electron",
    "node"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release && npx tsc",
    "build:debug": "napi build --platform && npx tsc",
    "build:ts": "npx tsc",
    "test": "node --test --test-force-exit '__tests__/**/*.mjs'"
  },
  "napi": {
    "binaryName": "hush-sync-ts",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@types/node": "^25.7.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 18"
  }
}
