{
  "name": "hush-sync-ts",
  "version": "0.1.0",
  "description": "Node.js / Electron bindings for hush-sync",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "Apache-2.0",
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test '__tests__/**/*.mjs'"
  },
  "napi": {
    "binaryName": "hush-sync-ts",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  },
  "engines": {
    "node": ">= 18"
  }
}
